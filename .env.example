# Runtime connection used by the app. Neon's pooled (-pooler) endpoint.
#
# The schema is NOT set here. This Neon database is shared with an unrelated
# application that owns `public`, and src/lib/db.ts always selects `parohia` in
# code, because the Neon integration owns DATABASE_URL on Vercel and it cannot
# be edited by hand. Appending &schema=parohia is allowed and harmless; any
# OTHER schema makes the app refuse to start.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct, unpooled endpoint, used only by `prisma migrate`. Migrations cannot
# run through pgbouncer: it multiplexes connections, so Prisma's advisory lock
# would be handed to an arbitrary backend. prisma.config.ts adds the schema.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional. When set, the dev mailer appends verification codes here as well as
# logging them, which is how the test suite reads them. Never set in production.
# MAIL_OUTBOX=".mail/outbox.log"
