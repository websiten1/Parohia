# Runtime connection used by the app. Neon's pooled (-pooler) endpoint.
#
# schema=parohia is REQUIRED and is the source of truth. This Neon database is
# shared with an unrelated application that owns `public`, and src/lib/db.ts
# refuses to connect if this names any other schema. Note the `&`: the Neon URLs
# already carry sslmode, and the pooled one also carries channel_binding.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&schema=parohia"

# Direct, unpooled endpoint, used only by `prisma migrate`. Migrations cannot
# run through pgbouncer: it multiplexes connections, so Prisma's advisory lock
# would be handed to an arbitrary backend.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&schema=parohia"

# Optional. When set, the dev mailer appends verification codes here as well as
# logging them, which is how the test suite reads them. Never set in production.
# MAIL_OUTBOX=".mail/outbox.log"
